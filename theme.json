{
	"$schema": "https://schemas.wp.org/wp/6.1/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "primary",
					"color": "#1e73be",
					"name": "Primary"
				},
				{
					"slug": "accent",
					"color": "#d6993a",
					"name": "Accent"
				},
				{
					"slug": "body-bg",
					"color": "#d6993a",
					"name": "Body background"
				},
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "White"
				},
				{
					"slug": "text",
					"color": "#333333",
					"name": "Text"
				},
				{
					"slug": "text-muted",
					"color": "#666666",
					"name": "Muted text"
				}
			],
			"custom": true,
			"customGradient": true,
			"link": true
		},
		"layout": {
			"contentSize": "780px",
			"wideSize": "1060px"
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "Arial, Helvetica, sans-serif",
					"slug": "body",
					"name": "Body"
				},
				{
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif",
					"slug": "system",
					"name": "System UI"
				},
				{
					"fontFamily": "Georgia, \"Times New Roman\", Times, serif",
					"slug": "serif",
					"name": "Serif"
				},
				{
					"fontFamily": "Verdana, Geneva, sans-serif",
					"slug": "verdana",
					"name": "Verdana"
				},
				{
					"fontFamily": "\"Trebuchet MS\", Helvetica, sans-serif",
					"slug": "trebuchet",
					"name": "Trebuchet MS"
				},
				{
					"fontFamily": "Menlo, Consolas, Monaco, \"Liberation Mono\", \"Lucida Console\", monospace",
					"slug": "monospace",
					"name": "Monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "15px",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.25rem",
					"name": "Large"
				}
			],
			"dropCap": true,
			"lineHeight": true,
			"letterSpacing": true,
			"textDecoration": true,
			"textTransform": true
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw",
				"vh"
			]
		},
		"custom": {
			"radius": {
				"small": "4px",
				"medium": "6px",
				"pill": "999px"
			},
			"color": {
				"heading": "var(--tso-color-heading, #111111)",
				"accentText": "var(--tso-color-accent-text, #876025)",
				"border": "var(--tso-color-border, #e0e0e0)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "4px"
				}
			},
			"heading": {
				"color": {
					"text": "var(--tso-color-heading, #111111)"
				},
				"typography": {
					"fontFamily": "var(--tso-font-heading, Arial, Helvetica, sans-serif)",
					"fontWeight": "var(--tso-font-heading-weight, 700)"
				}
			}
		}
	}
}
